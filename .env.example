# OpenRouter key used by the AI Studio feature.
# Never commit a real key. Set this in a local .env file or deployment secret.
VITE_OPENROUTER_API_KEY=""
# Optional OpenRouter model override. The default uses OpenRouter's automatic routing.
VITE_OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Supabase client config for Vite React app
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
